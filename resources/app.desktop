[Desktop Entry]
Name=LiquidMon
Comment=COSMIC panel applet for AIO liquid cooler temps and fan/pump duties via liquidctl
Type=Application
Icon=com.github.cosmix.LiquidMon
Exec=liquidmon
Terminal=false
StartupNotify=true
Categories=System;Monitor;X-COSMIC;
Keywords=COSMIC;AIO;liquidctl;cooler;temperature;
NoDisplay=true
X-CosmicApplet=true
X-CosmicHoverPopup=Auto
